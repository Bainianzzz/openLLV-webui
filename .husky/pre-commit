#!/bin/sh
set -e

# No HEAD yet (initial commit): diff --cached is unavailable, run the full suite
if ! git rev-parse --verify HEAD >/dev/null 2>&1; then
  exec uv run pytest -q
fi

has_python=0

# -z safely handles paths with spaces
while IFS= read -r path; do
  case "$path" in
    *.py) has_python=1 ;;
  esac
done <<EOF
$(git diff --cached --name-only -z -M | tr '\0' '\n')
EOF

# Commits unrelated to Python (docs/config/etc.) pass through
if [ "$has_python" -eq 0 ]; then
  echo "skip"
  exit 0
fi

echo "running tests: uv run pytest -q"
exec uv run pytest -q
